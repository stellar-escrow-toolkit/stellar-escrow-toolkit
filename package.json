{
  "name": "stellar-escrow-toolkit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Escrow & Milestone Payment Framework and TypeScript SDK for Stellar & Soroban",
  "workspaces": [
    "packages/sdk",
    "packages/react",
    "packages/cli",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "contracts:build": "cd contracts && cargo build --target wasm32-unknown-unknown --release",
    "contracts:test": "cd contracts && cargo test"
  },
  "keywords": [
    "stellar",
    "soroban",
    "escrow",
    "smart-contracts",
    "milestone-payments",
    "multisig",
    "defi",
    "web3"
  ],
  "author": "Stellar Escrow Toolkit Contributors",
  "license": "Apache-2.0"
}
